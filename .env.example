# Copy this file to .env and fill in your values. Never commit .env (git-ignored).

# --- Telegram Bot (required) ---
# Bot token from @BotFather, e.g. 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_TOKEN=

# Target Telegram channel to broadcast to: @channelusername or numeric channel id
TARGET_TELEGRAM_CHANNEL_ID=

# Only this Telegram user ID may send commands/messages to the bot
ALLOWED_TELEGRAM_USER_ID=

# --- Cloudflare relay (optional; bypasses Telegram network restrictions) ---
# Base URL of your deployed relay worker, e.g. https://relay.mrez321.ir
RELAY_URL=
# Optional secret path segment configured on the relay worker (PATH_PREFIX)
RELAY_PATH_PREFIX=

# --- Admin / mountable hub (required for API & dashboard) ---
# Secret protecting the mountable hub API endpoints and admin dashboard
ADMIN_SECRET=

# --- Retry / timeout tuning (optional) ---
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
TIMEOUT=5000
DEBUG_MODE=false
